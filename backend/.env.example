NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_TIMEOUT=120
NVIDIA_MAX_RETRIES=2
NVIDIA_RETRY_DELAY=2
NVIDIA_MAX_TOKENS=8192
NVIDIA_TEMPERATURE=0.1
NVIDIA_SEED=0
# Optionnel : laisser vide pour utiliser la dimension native retournee par le modele d'embedding.
NVIDIA_EMBEDDING_DIMENSIONS=

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/smartrecruit
MAX_UPLOAD_MB=20
# Optionnel : laisser vide pour calculer MAX_UPLOAD_MB * 1024 * 1024.
MAX_UPLOAD_BYTES=
MAX_TOTAL_UPLOAD_MB=100
# Optionnel : laisser vide pour calculer MAX_TOTAL_UPLOAD_MB * 1024 * 1024.
MAX_TOTAL_UPLOAD_BYTES=
MAX_CV_FILES=20
UPLOAD_CHUNK_BYTES=1048576
SMARTRECRUIT_API_KEY=change_me_for_local_development
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
JOB_WORKER_COUNT=2
EMBEDDING_BATCH_SIZE=32
LLM_INPUT_CHAR_LIMIT=12000
# Mode actif verifie: pgvector. Le mode json peut exister pour usages legacy/dev,
# mais il n'est pas la configuration locale cible.
VECTOR_BACKEND=pgvector
MODEL_AUDIT_LOG_PATH=storage/model_audit.jsonl
SMARTRECRUIT_RUN_INTEGRATION=0

VITE_API_URL=
VITE_SMARTRECRUIT_API_KEY=change_me_for_local_development
VITE_MAX_UPLOAD_MB=20
VITE_MAX_TOTAL_UPLOAD_MB=100
VITE_MAX_CV_FILES=20

# Role dans le projet:
# Ce fichier documente les variables attendues par le backend. Il sert de modele de configuration sans contenir les secrets reels charges par app.config.
